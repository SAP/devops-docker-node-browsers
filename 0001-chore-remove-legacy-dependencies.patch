From 9af6170b9f83df07b6df8e3694863aaa728363aa Mon Sep 17 00:00:00 2001
From: Oliver Feldmann <oliver.feldmann@sap.com>
Date: Wed, 13 May 2026 13:25:57 +0200
Subject: [PATCH] chore: remove legacy dependencies

Removes Java, libgconf-2-4, xvfb, and libxi6 as modern headless browsers no longer require these dependencies.

Co-Authored-By: Claude Opus 4.7 <noreply@anthropic.com>
---
 .github/workflows/build.yml   | 12 ++----------
 .github/workflows/release.yml | 12 ++----------
 Dockerfile                    |  8 ++------
 README.md                     |  2 --
 runTests.sh                   |  4 +---
 5 files changed, 7 insertions(+), 31 deletions(-)

diff --git a/.github/workflows/build.yml b/.github/workflows/build.yml
index 9e755c8..bf59a9b 100644
--- a/.github/workflows/build.yml
+++ b/.github/workflows/build.yml
@@ -16,20 +16,12 @@ jobs:
         base-image-tag: [20-bookworm, 22-bookworm, 24-bookworm, 26-trixie]
     steps:
     - uses: actions/checkout@master
-    - name: Determine Java version
-      id: java_version
-      run: |
-        if [[ "${{ matrix.base-image-tag }}" == *trixie* ]]; then
-          echo 'version=21' >> $GITHUB_OUTPUT
-        else
-          echo 'version=17' >> $GITHUB_OUTPUT
-        fi
     - name: Test
       run: |
-        chmod +x runTests.sh && ./runTests.sh ${{ matrix.base-image-tag }} ${{ steps.java_version.outputs.version }}
+        chmod +x runTests.sh && ./runTests.sh ${{ matrix.base-image-tag }}
     - name: Build
       run: |
-        docker build --build-arg=BASE_IMAGE_TAG=${{ matrix.base-image-tag }} --build-arg=JAVA_VERSION=${{ steps.java_version.outputs.version }} --tag ppiper/node-browsers:${{ matrix.base-image-tag }} .
+        docker build --build-arg=BASE_IMAGE_TAG=${{ matrix.base-image-tag }} --tag ppiper/node-browsers:${{ matrix.base-image-tag }} .
     - name: Tag latest image
       if: ${{ matrix.base-image-tag == '26-trixie' }}
       run: |
diff --git a/.github/workflows/release.yml b/.github/workflows/release.yml
index dd87cc5..15ca778 100644
--- a/.github/workflows/release.yml
+++ b/.github/workflows/release.yml
@@ -15,17 +15,9 @@ jobs:
         base-image-tag: [20-bookworm, 22-bookworm, 24-bookworm, 26-trixie]
     steps:
       - uses: actions/checkout@v3
-      - name: Determine Java version
-        id: java_version
-        run: |
-          if [[ "${{ matrix.base-image-tag }}" == *trixie* ]]; then
-            echo 'version=21' >> $GITHUB_OUTPUT
-          else
-            echo 'version=17' >> $GITHUB_OUTPUT
-          fi
       - name: Test
         run: |
-          chmod +x runTests.sh && ./runTests.sh ${{ matrix.base-image-tag }} ${{ steps.java_version.outputs.version }}
+          chmod +x runTests.sh && ./runTests.sh ${{ matrix.base-image-tag }}
       - name: Prepare Release
         run: |
           CURRENT_VERSION_LONG=$(curl --silent "https://api.github.com/repos/SAP/devops-docker-node-browsers/releases" | jq -r '.[].tag_name' | head -n1)
@@ -43,7 +35,7 @@ jobs:
       - name: Build and push
         run: |
           echo ${{ secrets.DOCKERHUB_PASSWORD }} | docker login -u ${{ secrets.DOCKERHUB_USER }} --password-stdin
-          docker build --build-arg=BASE_IMAGE_TAG=${{ matrix.base-image-tag }} --build-arg=JAVA_VERSION=${{ steps.java_version.outputs.version }} --tag ppiper/node-browsers:${{ env.PIPER_version }}-${{ matrix.base-image-tag }} .
+          docker build --build-arg=BASE_IMAGE_TAG=${{ matrix.base-image-tag }} --tag ppiper/node-browsers:${{ env.PIPER_version }}-${{ matrix.base-image-tag }} .
           docker push ppiper/node-browsers:${{ env.PIPER_version }}-${{ matrix.base-image-tag }}
       - name: Tag and push node 26 image
         if: ${{ matrix.base-image-tag == '26-trixie' }}
diff --git a/Dockerfile b/Dockerfile
index eeee0f3..8cf55be 100644
--- a/Dockerfile
+++ b/Dockerfile
@@ -2,12 +2,8 @@ ARG BASE_IMAGE_TAG
 
 FROM node:$BASE_IMAGE_TAG
 
-ARG JAVA_VERSION
-
-RUN DEBIAN_VERSION=$(. /etc/os-release && echo "$VERSION_CODENAME") && \
-    if [ "$DEBIAN_VERSION" != "trixie" ]; then EXTRAS="libgconf-2-4"; fi && \
-    apt-get update && \
-    apt-get install -y chromium firefox-esr xvfb libxi6 libgbm1 $EXTRAS openjdk-"${JAVA_VERSION}"-jre && \
+RUN apt-get update && \
+    apt-get install -y chromium firefox-esr libgbm1 && \
     rm -rf /var/lib/apt/lists/* /var/cache/apt/* && \
     ln -s /usr/bin/chromium /usr/bin/google-chrome
 
diff --git a/README.md b/README.md
index 5ede879..d7ce652 100644
--- a/README.md
+++ b/README.md
@@ -35,8 +35,6 @@ docker pull ppiper/node-browsers:24-bookworm
 docker pull ppiper/node-browsers:26-trixie
 ```
 
-> **⚠️ Note:** The `26-trixie` image is based on Debian Trixie (13) which ships Java 21 by default instead of Java 17 (Bookworm). Please ensure your project is compatible with Java 21.
-
 ## Build
 
 To build this image locally, open a terminal in the directory of the Dockerfile and run
diff --git a/runTests.sh b/runTests.sh
index fa1cbdf..22e82ad 100755
--- a/runTests.sh
+++ b/runTests.sh
@@ -1,14 +1,12 @@
 #!/bin/bash -ex
 
 TAG=${1:-.}
-JAVA_VERSION=${2}
 
 echo Testing version $TAG
 
-docker build --build-arg=BASE_IMAGE_TAG=${TAG} --build-arg=JAVA_VERSION=${JAVA_VERSION} -t localhost:5000/ppiper/node-browsers:${TAG} .
+docker build --build-arg=BASE_IMAGE_TAG=${TAG} -t localhost:5000/ppiper/node-browsers:${TAG} .
 
 docker run --rm localhost:5000/ppiper/node-browsers:${TAG} chromium --version
 docker run --rm localhost:5000/ppiper/node-browsers:${TAG} firefox --version
-docker run --rm localhost:5000/ppiper/node-browsers:${TAG} java -version
 docker run --rm localhost:5000/ppiper/node-browsers:${TAG} node --version
 docker run --rm localhost:5000/ppiper/node-browsers:${TAG} cat /etc/os-release
\ No newline at end of file
-- 
